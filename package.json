{
  "name": "rodmjay-site",
  "private": true,
  "type": "module",
  "description": "rodmjay.com: a Next.js static export (home, blog, recipes, resume form) served by Azure Static Web Apps.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cms-snapshot.mjs && next build && node scripts/postbuild.mjs && node scripts/should.mjs",
    "test": "node tests/old-urls.mjs && node tests/consent-hashes.mjs && node tests/no-exif.mjs && playwright test",
    "test:urls": "node tests/old-urls.mjs",
    "test:rvp": "node --test tests/rvp.test.ts",
    "test:e2e": "playwright test",
    "test:skew": "node --test tests/skew.test.mjs",
    "test:consent": "node tests/consent-hashes.mjs",
    "test:exif": "node tests/no-exif.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "image-size": "2.0.4",
    "js-yaml": "5.4.3",
    "markdown-it": "15.0.3",
    "markdown-it-container": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "shiki": "4.5.0",
    "typescript": "5.9.3"
  }
}
