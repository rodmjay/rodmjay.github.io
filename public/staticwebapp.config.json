{
  "trailingSlash": "always",
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "routes": [
    { "route": "/admin/*", "headers": { "X-Robots-Tag": "noindex", "Cache-Control": "no-cache" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".xml": "application/xml",
    ".webp": "image/webp",
    ".woff2": "font/woff2"
  }
}
