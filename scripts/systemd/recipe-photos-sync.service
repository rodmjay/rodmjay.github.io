# rodmjay.com recipe photos (scripts/recipe-photos-sync.py). Owner Software Architect; installed by IT Guy.
# Runs the sync from its own worktree of the site repo; gh and git use Rod's existing login on this machine.
[Unit]
Description=rodmjay.com: bring new or changed recipe photos to the site

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/recipe-photos-sync/site
ExecStartPre=/usr/bin/bash -c 'test -d %h/.local/share/recipe-photos-sync/site || git -C %h/dev/rodmjay.github.io worktree add --detach %h/.local/share/recipe-photos-sync/site origin/main'
ExecStart=/usr/bin/python3 %h/.local/share/recipe-photos-sync/site/scripts/recipe-photos-sync.py
TimeoutStartSec=45min
Nice=10
